# Copy to .env.local for local development. Never commit real secrets.

# development | test | production (set APP_ENV=production on Vercel Production AND Preview)
APP_ENV=development

# Postgres connection. Local: `npm run db:start` serves this URL.
# Production: Supabase "Transaction pooler" connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/ibada

# Public URL of the shop (https in production)
SITE_URL=http://localhost:3000

# At least 32 random characters: `openssl rand -base64 48`
BETTER_AUTH_SECRET=

# local (writes .data/uploads, dev only) | supabase (required in production)
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Web Push keys: `npm run push:keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ibadashop.com

# Cloudflare Turnstile. Leave empty in development to use Cloudflare's always-pass test keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Multiplies every rate limit. Must be 1 in production (E2E uses 100).
RATE_LIMIT_MULTIPLIER=1
